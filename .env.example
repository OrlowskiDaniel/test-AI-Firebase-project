# Copy this file to .env.local and fill in values from your Firebase
# project's web app config (Firebase console > Project settings > Your apps).
#
# .env.local is git-ignored — never commit real values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Only needed for production/deployed builds (App Check reCAPTCHA v3 site key).
# Leave empty for local dev — firebase.js falls back to the App Check debug
# token flow when running `npm run dev`.
VITE_RECAPTCHA_SITE_KEY=
